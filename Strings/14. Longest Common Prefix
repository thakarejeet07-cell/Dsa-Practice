class Solution {

    public String longestCommonPrefix(String[] strs) {
        if (strs == null || strs.length == 0) {
                    return "";
                }
        String left = strs[0];
        int right = 1;
        String ans = strs[0];
 
        while (right < strs.length) {

            int n = Math.min(left.length(), strs[right].length());
            ans = "";

            for (int i = 0; i < n; i++) {

                if (strs[right].charAt(i) != left.charAt(i)) {
                    break;
                } else {
                    ans += left.charAt(i);
                }
            }

            left = ans;
            right++;
        }

        return ans;
    }
}