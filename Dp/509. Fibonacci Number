class Solution {
    static int [] dp;
    public int helpFib(int n){
        if(n<=1) return n;
        if(dp[n] != 0){
            return dp[n];
        }
        int ans = fib(n-1) + fib(n-2);
        return ans;
    }
   

    public int fib(int n) {
        dp = new int [n+1];
        return helpFib(n);  
    }
}