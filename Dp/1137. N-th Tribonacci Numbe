import java.util.*;

class Solution {
    static int[]dp;
    public int tribonacci(int n) {
        dp = new int[n + 1];
        Arrays.fill(dp,-1);
        return helper(n,n);  
    }
    public int helper(int i,int n){
        if (i == 0) return 0;
        if (i == 1 || i == 2) return 1;
        if(dp[i] != -1) return dp[i];
        return dp[i] = helper(i - 1, n) 
             + helper(i - 2, n) 
             + helper(i - 3, n);
    }
}