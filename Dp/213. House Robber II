import java.util.*;

class Solution {
    static int[] dp;
    int n;
    public int rob(int[] nums) {
        n = nums.length;
        if (n == 1) return nums[0];
        dp = new int[n+1];
        Arrays.fill(dp,-1);
        int case1 = helper(0, nums, n - 2);
        Arrays.fill(dp,-1);
        int case2 = helper(1, nums, n - 1);
        return Math.max(case1,case2); 
    }
    public int helper(int i,int[] nums,int end){
        if (i > end) return 0;
        if(n == 1) return nums[0];

        if (dp[i] != -1) return dp[i];

        int pick = nums[i] + helper(i + 2, nums, end);
        int skip = helper(i + 1, nums, end);

        return dp[i] = Math.max(pick, skip);
       
    }
}