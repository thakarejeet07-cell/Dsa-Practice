import java.util.*;

class Solution {
    static class Item {
        int value, weight;
        Item(int value, int weight) {
            this.value = value;
            this.weight = weight;
        }
    }

    public double fractionalKnapsack(int W, Item[] arr, int n) {

        Arrays.sort(arr, (a, b) -> 
            Double.compare((double)b.value / b.weight, (double)a.value / a.weight)
        );

        double totalValue = 0.0;

        for (int i = 0; i < n; i++) {
            if (arr[i].weight <= W) {
                totalValue += arr[i].value;
                W -= arr[i].weight;
            } else {
                totalValue += (double)arr[i].value * ((double)W / arr[i].weight);
                break;
            }
        }
    return totalValue;
    }
}