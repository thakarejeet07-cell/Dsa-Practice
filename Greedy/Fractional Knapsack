import java.util.Arrays;

public class FractionalKnapsack {

    // Class to represent each supply item
    static class Item {
        int id;
        double weight;
        double value;
        double ratio;

        Item(int id, double weight, double value) {
            this.id = id;
            this.weight = weight;
            this.value = value;
            this.ratio = value / weight; // Value per unit weight
        }
    }

    public static void main(String[] args) {
        double capacity = 15; // Truck max capacity (W = 15 kg)

        Item[] items = {
            new Item(1, 5, 30),
            new Item(2, 10, 50),
            new Item(3, 3, 24),
            new Item(4, 7, 42)
        };

        // Sort items in descending order of value/weight ratio
        Arrays.sort(items, (a, b) -> Double.compare(b.ratio, a.ratio));

        double totalValue = 0;
        double currentWeight = 0;
        double[] fractions = new double[items.length + 1];

        for (Item item : items) {
            if (currentWeight + item.weight <= capacity) {
                // Take full item
                totalValue += item.value;
                currentWeight += item.weight;
                fractions[item.id] = 1.00;
            } else {
                // Take fraction of item to fill remaining capacity
                double spaceLeft = capacity - currentWeight;
                if (spaceLeft > 0) {
                    double frac = spaceLeft / item.weight;
                    totalValue += frac * item.value;
                    fractions[item.id] = frac;
                }
                break; // Knapsack is full
            }
        }

        System.out.printf("Maximum Total Value: %.2f\n", totalValue);
        System.out.println("Fractions taken for each item ID:");
        for (int i = 1; i < fractions.length; i++) {
            System.out.printf("Item %d: %.2f (%.0f%%)\n", i, fractions[i], fractions[i] * 100);
        }
    }
}