class Solution {
    public boolean lemonadeChange(int[] bills) {
        int five = 0;
        int ten = 0;
        for(int ele : bills){
            int cN = ele - 5;
            if(cN == 5){
                if(five <= 0){
                    return false;
                }
                five--;
                ten++;
            } else if(cN == 0){
                five++;
            } else {
                if (ten >= 1 && five >= 1){
                    five--;
                    ten--;
                } else if(five >=3) {
                    five -= 3;
                }
                else{
                    return false;
                }
            }
        }
        return true;     
    }
}