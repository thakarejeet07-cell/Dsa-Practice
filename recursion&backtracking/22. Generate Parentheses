class Solution {
    public List<String> generateParenthesis(int n) {
        List<String> result = new ArrayList<>();
        helper(n, 0, 0, "", result);
        return result;
    }

    public void helper(int n, int open, int close,
                       String curr, List<String> result) {


        if (open == n && close == n) {
            result.add(curr);
            return;
        }


        if (open < n) {
            helper(n, open + 1, close, curr + "(", result);
        }

 
        if (close < open) {
            helper(n, open, close + 1, curr + ")", result);
        }
    }
}