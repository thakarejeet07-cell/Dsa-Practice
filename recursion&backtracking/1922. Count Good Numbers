class Solution {
    static final int MOD = 1_000_000_007;

    public int countGoodNumbers(long n) {
        long evenCount = (n + 1) / 2;
        long oddCount = n / 2;
        
        long evenWays = power(5, evenCount, MOD);
        long oddWays = power(4, oddCount, MOD);

        return (int) ((evenWays * oddWays) % MOD);                
        
    }
    public long power(long base,long exp,long mod){
        if (exp == 0) {
            return 1;
        }
        long half = power(base,exp/2,mod);
        long halfSquared = (half * half) % mod;
        if(exp % 2 == 0){
            return halfSquared;
        } else {
            return (halfSquared * (base % mod)) % mod;
        }

    }
}